# Copy to .env on the VPS (never commit .env). Used by docker-compose.prod.yml / Caddy.
SMARTSKU_DOMAIN=app-smartsku.online
SMARTSKU_DASHBOARD_USER=smartsku
# bcrypt hash: docker run --rm caddy:2 caddy hash-password --plaintext '<password>'
# Escape every $ as $$ (compose interpolates .env values)
SMARTSKU_DASHBOARD_PASSWORD_HASH=
