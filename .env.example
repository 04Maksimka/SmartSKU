# Copy to .env on the VPS (never commit .env). Used by docker-compose.prod.yml / Caddy.
SMARTSKU_DOMAIN=app-smartsku.online
SMARTSKU_DASHBOARD_USER=smartsku
# bcrypt hash: docker run --rm caddy:2 caddy hash-password --plaintext '<password>'
# Escape every $ as $$ (compose interpolates .env values)
SMARTSKU_DASHBOARD_PASSWORD_HASH=
# Optional guest link without the password (demo): https://<domain>/?guest=<token>, works until the unix time below.
# Token: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'; empty — no guest access
SMARTSKU_GUEST_TOKEN=
SMARTSKU_GUEST_UNTIL=0
# Optional view-only link (look and search, no changes): https://<domain>/?view=<token>, until the unix time below
SMARTSKU_VIEWER_TOKEN=
SMARTSKU_VIEWER_UNTIL=0
