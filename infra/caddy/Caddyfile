# Public entry point on the VPS: HTTPS with an automatic Let's Encrypt certificate, dashboard behind a login.
# Values come from .env next to docker-compose.prod.yml (see .env.example).
{$SMARTSKU_DOMAIN} {
	encode gzip

	# /?exit forgets both guest cookies on this browser: back to the password
	@exit query exit=*
	handle @exit {
		header +Set-Cookie "skubox_viewer=; Path=/; Max-Age=0; Secure; HttpOnly; SameSite=Lax"
		header +Set-Cookie "skubox_guest=; Path=/; Max-Age=0; Secure; HttpOnly; SameSite=Lax"
		redir * / 302
	}

	# Guest link for a demo (jury, customers): https://<domain>/?guest=<SMARTSKU_GUEST_TOKEN> sets a cookie and opens
	# the dashboard without the password, with full rights, until SMARTSKU_GUEST_UNTIL (unix time). After that both
	# the link and the cookie stop working by themselves. No token (shorter than 16 characters) — no guest access.
	@guest_link {
		query guest={$SMARTSKU_GUEST_TOKEN:none}
		expression `size("{$SMARTSKU_GUEST_TOKEN:none}") >= 16 && int({time.now.unix}) < {$SMARTSKU_GUEST_UNTIL:0}`
	}
	handle @guest_link {
		header Set-Cookie "skubox_guest={$SMARTSKU_GUEST_TOKEN:none}; Path=/; Max-Age=172800; Secure; HttpOnly; SameSite=Lax"
		# Drops the token from the address bar
		redir * / 302
	}

	@guest {
		header Cookie *skubox_guest={$SMARTSKU_GUEST_TOKEN:none}*
		expression `size("{$SMARTSKU_GUEST_TOKEN:none}") >= 16 && int({time.now.unix}) < {$SMARTSKU_GUEST_UNTIL:0}`
	}
	handle @guest {
		reverse_proxy frontend:80
	}

	# View-only link, the same way: https://<domain>/?view=<SMARTSKU_VIEWER_TOKEN>, until SMARTSKU_VIEWER_UNTIL. Everything
	# can be looked at and a component can be searched for; any other change is rejected here, before the backend. The
	# dashboard asks /api/access (answered only here) and makes its buttons explain that instead of acting.
	@viewer_link {
		query view={$SMARTSKU_VIEWER_TOKEN:none}
		expression `size("{$SMARTSKU_VIEWER_TOKEN:none}") >= 16 && int({time.now.unix}) < {$SMARTSKU_VIEWER_UNTIL:0}`
	}
	handle @viewer_link {
		header Set-Cookie "skubox_viewer={$SMARTSKU_VIEWER_TOKEN:none}; Path=/; Max-Age=172800; Secure; HttpOnly; SameSite=Lax"
		redir * / 302
	}

	# A browser that sends the dashboard password is never limited by a view-only cookie left from the link
	@viewer {
		not header Authorization *
		header Cookie *skubox_viewer={$SMARTSKU_VIEWER_TOKEN:none}*
		expression `size("{$SMARTSKU_VIEWER_TOKEN:none}") >= 16 && int({time.now.unix}) < {$SMARTSKU_VIEWER_UNTIL:0}`
	}
	handle @viewer {
		@access path /api/access
		handle @access {
			header Content-Type application/json
			respond `\{"read_only": true\}` 200
		}
		@write {
			not method GET HEAD
			not path /api/locate
		}
		handle @write {
			header Content-Type application/json
			respond `\{"detail": "Режим только просмотра: это действие недоступно"\}` 403
		}
		handle {
			reverse_proxy frontend:80
		}
	}

	handle {
		basic_auth {
			{$SMARTSKU_DASHBOARD_USER} {$SMARTSKU_DASHBOARD_PASSWORD_HASH}
		}
		# The frontend's nginx serves the page and proxies /api to the backend
		reverse_proxy frontend:80
	}
}
